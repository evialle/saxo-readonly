# Copy outside the repository, edit locally, then select with --config or
# SAXO_CONFIG_FILE. Do not commit your real configuration.
# Environment variables override values from this file.
SAXO_ENV=SIM

# Register an application for the selected Saxo environment.
# Default: public PKCE application, without an AppSecret.
SAXO_OAUTH_FLOW=pkce
SAXO_APP_KEY=
SAXO_APP_SECRET=

# PKCE: register http://localhost/callback at Saxo (without a port).
# The runtime request uses the URL below. There is no local callback server;
# paste the complete browser callback URL into the auth-finish hidden prompt.
# For confidential code flow, use its exact registered redirect URI.
SAXO_REDIRECT_URI=http://localhost:8765/callback

# Optional storage root; sim/live subdirectories are created automatically.
# Use a private local directory outside Git and cloud-synced folders.
# SAXO_DATA_DIR=C:\Users\your-user\AppData\Local\saxo-readonly\data

# No SAXO_THRESHOLD_PCT setting: use alerts --threshold 3.
